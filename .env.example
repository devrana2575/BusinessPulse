# BusinessPulse local configuration (copy to .env and fill in)
# Never commit the real .env file.

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=businesspulse
MYSQL_TEST_DATABASE=businesspulse_test
MYSQL_USER=bp_user
MYSQL_PASSWORD=change_me

# Optional: only used by scripts/setup_database.py when creating the
# database/user for the first time. Leave blank if you create them manually.
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD=

# Collection settings (optional overrides)
OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter
COLLECTION_DATE=2026-11-02
