{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.0.0/schema.json",
  "name": "executive_city_category_matrix",
  "position": {
    "x": 490,
    "y": 470,
    "z": 0,
    "width": 766,
    "height": 214,
    "tabOrder": 602090
  },
  "visual": {
    "visualType": "matrix",
    "query": {
      "queryState": {
        "Rows": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "DimCity"
                    }
                  },
                  "Property": "city_name"
                }
              },
              "queryRef": "DimCity.city_name"
            }
          ]
        },
        "Columns": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "DimCategory"
                    }
                  },
                  "Property": "category_name"
                }
              },
              "queryRef": "DimCategory.category_name"
            }
          ]
        },
        "Values": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Total Listings"
                }
              },
              "queryRef": "_Measures.Total Listings"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Listings by city and category'"
                }
              }
            }
          }
        }
      ]
    }
  }
}
