/// Generated by scripts/build_powerbi_desktop_project.py.
table _Measures

    column MeasureHost
        dataType: int64
        lineageTag: eb88041a-cb33-59f6-a4c2-6fb2b08f6567
        summarizeBy: none
        sourceColumn: MeasureHost

    measure 'Total Listings' =
            COUNTROWS ( FactListings )
        formatString: #,0
        displayFolder: '01 Volume'
        lineageTag: 7455c134-5e49-5b6e-9d83-90d84a3375f1
    measure 'Unique Businesses' =
            DISTINCTCOUNT ( FactListings[business_id] )
        formatString: #,0
        displayFolder: '01 Volume'
        lineageTag: 90026d14-040b-5c4b-89c1-76fa9a8f492f
    measure 'Total Cities' =
            DISTINCTCOUNT ( FactListings[city_id] )
        formatString: 0
        displayFolder: '01 Volume'
        lineageTag: 5fa74dc8-b26a-5c37-ab74-8a468ef24306
    measure 'Total Categories' =
            DISTINCTCOUNT ( FactListings[category_id] )
        formatString: 0
        displayFolder: '01 Volume'
        lineageTag: e2888b1d-c5b0-5b31-a00e-623e5ddcbae2
    measure 'Avg Listings per City' =
            DIVIDE ( [Total Listings], [Total Cities] )
        formatString: #,0.0
        displayFolder: '01 Volume'
        lineageTag: 0c1c9535-569f-50b6-8188-f8ff435fa796
    measure 'Listing Share %' =
            DIVIDE (
                    [Total Listings],
                    CALCULATE ( [Total Listings], ALLSELECTED ( DimCity ), ALLSELECTED ( DimCategory ) )
                )
        formatString: 0.0%
        displayFolder: '01 Volume'
        lineageTag: be9d263a-ab6c-5528-908d-1eb70885e128
    measure 'Snapshot Date' =
            MAX ( FactListings[collection_date] )
        formatString: dd mmm yyyy
        displayFolder: '01 Volume'
        lineageTag: df1fdfee-779c-57c7-bbf1-833b9b67ea75
    measure 'Largest City Listings' =
            MAXX ( ALLSELECTED ( DimCity ), [Total Listings] )
        formatString: #,0
        displayFolder: '01 Volume'
        lineageTag: ed889186-bfe5-5d17-ade2-e880ed9130b9
    measure 'Smallest City Listings' =
            MINX ( ALLSELECTED ( DimCity ), [Total Listings] )
        formatString: #,0
        displayFolder: '01 Volume'
        lineageTag: 45366604-104c-5819-9976-ac1b3cf036fd
    measure 'City Rank' =
            RANKX ( ALLSELECTED ( DimCity[city_name] ), [Total Listings], , DESC, DENSE )


            // -----------------------------------------------------------------------------
            // 02 Concentration & Coverage
            // -----------------------------------------------------------------------------
        formatString: 0
        displayFolder: '01 Volume'
        lineageTag: b1b2a2d2-8614-5dc6-b939-9e40459d70f3
    measure 'Top City Share %' =
            DIVIDE (
                    MAXX ( ALLSELECTED ( DimCity ), [Total Listings] ),
                    CALCULATE ( [Total Listings], ALLSELECTED ( DimCity ) )
                )
        formatString: 0.00%
        displayFolder: '02 Concentration & Coverage'
        lineageTag: d3a930d5-1885-5fc1-94db-91197fbdba15
    measure 'City HHI' =
            VAR _total = CALCULATE ( [Total Listings], ALLSELECTED ( DimCity ) )
                RETURN
                    SUMX ( ALLSELECTED ( DimCity ), POWER ( DIVIDE ( [Total Listings], _total ), 2 ) )
        formatString: 0.0000
        displayFolder: '02 Concentration & Coverage'
        lineageTag: f5e0ea5a-b0ed-5d6e-b806-c0aae95b74ba
    measure 'Category Coverage %' =
            DIVIDE (
                    DISTINCTCOUNT ( FactListings[category_id] ),
                    CALCULATE ( COUNTROWS ( DimCategory ), ALL ( DimCategory ) )
                )
        formatString: 0.0%
        displayFolder: '02 Concentration & Coverage'
        lineageTag: e867dbd0-adeb-589f-8ad1-3c12dbb9bafe
    measure 'City Coverage %' =
            DIVIDE (
                    DISTINCTCOUNT ( FactListings[city_id] ),
                    CALCULATE ( COUNTROWS ( DimCity ), ALL ( DimCity ) )
                )
        formatString: 0.0%
        displayFolder: '02 Concentration & Coverage'
        lineageTag: bf997bfb-e28e-5cfd-bf8b-122791738b3b
    measure 'Total Pairs' =
            COUNTROWS ( FactCityCategoryCoverage )
        formatString: #,0
        displayFolder: '02 Concentration & Coverage'
        lineageTag: 57be28bf-59cb-53b2-8c36-760be9136ddb
    measure 'Covered Pairs' =
            SUM ( FactCityCategoryCoverage[is_covered] )
        formatString: #,0
        displayFolder: '02 Concentration & Coverage'
        lineageTag: 1e5bf6d8-93d4-5d01-8c1e-b0867567f609
    measure 'Uncovered Pairs' =
            [Total Pairs] - [Covered Pairs]
        formatString: #,0
        displayFolder: '02 Concentration & Coverage'
        lineageTag: 1e0d916e-d9a7-57da-975c-9e4c480a2dd6
    measure 'Pair Coverage %' =
            DIVIDE ( [Covered Pairs], [Total Pairs] )
        formatString: 0.00%
        displayFolder: '02 Concentration & Coverage'
        lineageTag: f1eb3398-48ea-58a3-a3e2-e0d84b4f28aa
    measure 'Pair Listings' =
            SUM ( FactCityCategoryCoverage[listing_count] )
        formatString: #,0
        displayFolder: '02 Concentration & Coverage'
        lineageTag: ac37cad4-a2de-528c-8c2e-63e63ca89c7f
    measure 'Missing Categories' =
            CONCATENATEX (
                    FILTER ( ALL ( DimCategory[category_name] ), CALCULATE ( [Total Listings] ) = 0 ),
                    DimCategory[category_name], ", ", DimCategory[category_name], ASC
                )


            // -----------------------------------------------------------------------------
            // 03 Data Quality
            // -----------------------------------------------------------------------------
        displayFolder: '02 Concentration & Coverage'
        lineageTag: dd75b146-64e8-5c1e-9c4a-e91401f35a0a
    measure 'Duplicate Count' =
            SUM ( FactListings[duplicate_flag] )
        formatString: #,0
        displayFolder: '03 Data Quality'
        lineageTag: e46d8c1b-4841-5722-aad0-58fb5df67ebd
    measure 'Missing Phone Count' =
            SUM ( FactListings[missing_phone] )
        formatString: #,0
        displayFolder: '03 Data Quality'
        lineageTag: ee7038aa-a25e-5ae0-9761-780eb12530f8
    measure 'Missing Address Count' =
            SUM ( FactListings[missing_address] )
        formatString: #,0
        displayFolder: '03 Data Quality'
        lineageTag: 3d9d4687-6152-5516-8192-bccc579bcfd3
    measure 'Missing Phone %' =
            DIVIDE ( [Missing Phone Count], [Total Listings] )
        formatString: 0.0%
        displayFolder: '03 Data Quality'
        lineageTag: ddca5430-7552-5f1a-a922-320e12648b5f
    measure 'Missing Address %' =
            DIVIDE ( [Missing Address Count], [Total Listings] )
        formatString: 0.0%
        displayFolder: '03 Data Quality'
        lineageTag: 6775a4c0-d9ab-5c78-8d0c-e1ce88d4a92a
    measure 'Invalid Phone Count' =
            SUM ( FactListings[invalid_phone] )
        formatString: #,0
        displayFolder: '03 Data Quality'
        lineageTag: d7c4fd3b-9355-5256-b155-14ac2efeedee
    measure 'Invalid Address Count' =
            SUM ( FactListings[invalid_address] )
        formatString: #,0
        displayFolder: '03 Data Quality'
        lineageTag: 17cd8840-06e7-51f6-802a-999489fa50d4
    measure 'Missing Coordinate Count' =
            COUNTROWS (
                    FILTER ( FactListings, ISBLANK ( FactListings[latitude] ) || ISBLANK ( FactListings[longitude] ) )
                )
        formatString: #,0
        displayFolder: '03 Data Quality'
        lineageTag: e24e50ab-4dd7-5dff-82a4-cae4c11e7397
    measure 'Invalid Coordinate Count' =
            SUM ( FactListings[invalid_coordinate] )
        formatString: #,0
        displayFolder: '03 Data Quality'
        lineageTag: d8e42ce2-37d8-52cb-82dc-f2bf8b38e432
    measure 'Outside City Bbox Count' =
            SUM ( FactListings[outside_city_bbox] )
        formatString: #,0
        displayFolder: '03 Data Quality'
        lineageTag: 9c1b6f79-d39f-57da-ab3a-bf7b3be6107f
    measure 'Missing Business Name Count' =
            COUNTROWS (
                    FILTER ( FactListings, ISBLANK ( FactListings[business_name] ) || TRIM ( FactListings[business_name] ) = "" )
                )
        formatString: #,0
        displayFolder: '03 Data Quality'
        lineageTag: ef151c5a-9b58-5b7a-a1a3-1a086fe9b223
    measure 'Missing Category Count' =
            COUNTROWS ( FILTER ( FactListings, ISBLANK ( FactListings[category_id] ) ) )
        formatString: #,0
        displayFolder: '03 Data Quality'
        lineageTag: c128ec46-ef7d-5491-8087-30ce79ff88de
    measure 'Quality Issue Rows' =
            COUNTROWS ( FactQualityIssues )
        formatString: #,0
        displayFolder: '03 Data Quality'
        lineageTag: 97e98b56-187c-57ef-9cd1-fb121c24305a
    measure 'Data Quality Issue Count' =
            [Quality Issue Rows] + [Duplicate Count] + [Invalid Coordinate Count]
        formatString: #,0
        displayFolder: '03 Data Quality'
        lineageTag: aac1f3e7-7d93-5067-9b0b-257ef9aa2833
    measure 'Needs Review Records' =
            CALCULATE ( [Total Listings], FactListings[validation_status] = "needs_review" )
        formatString: #,0
        displayFolder: '03 Data Quality'
        lineageTag: f975601f-390f-572f-85cb-4dca701acfd9
    measure 'Complete Records' =
            SUM ( FactListings[is_complete] )
        formatString: #,0
        displayFolder: '03 Data Quality'
        lineageTag: e07449fe-4557-5151-bd2f-979b85eabef1
    measure 'Complete Records %' =
            DIVIDE ( [Complete Records], [Total Listings] )
        formatString: 0.00%
        displayFolder: '03 Data Quality'
        lineageTag: bf1045b1-f78d-52c1-883e-f02c0d50fea4
    measure 'Avg Quality Score' =
            AVERAGE ( FactListings[quality_score] )
        formatString: 0.00
        displayFolder: '03 Data Quality'
        lineageTag: e02a26f7-a116-5dd9-aca6-65a8128629e9
    measure 'Data Quality %' =
            DIVIDE ( [Avg Quality Score], 100 )


            // -----------------------------------------------------------------------------
            // 04 Opportunity
            // -----------------------------------------------------------------------------
        formatString: 0.0%
        displayFolder: '03 Data Quality'
        lineageTag: 6170efc6-d6d4-5f29-9544-6ffd9636649b
    measure 'Candidate Pairs' =
            SUM ( FactCityCategoryCoverage[is_candidate] )
        formatString: #,0
        displayFolder: '04 Opportunity'
        lineageTag: 7cf7ae64-69d4-5bfe-ba17-14fa3341a13a
    measure 'High Opportunity Pairs' =
            CALCULATE ( COUNTROWS ( FactCityCategoryCoverage ), FactCityCategoryCoverage[opportunity_tier] = "High" )
        formatString: #,0
        displayFolder: '04 Opportunity'
        lineageTag: d23f27ee-c6a7-5f51-910f-ab76ba9c61b8
    measure 'Medium Opportunity Pairs' =
            CALCULATE ( COUNTROWS ( FactCityCategoryCoverage ), FactCityCategoryCoverage[opportunity_tier] = "Medium" )
        formatString: #,0
        displayFolder: '04 Opportunity'
        lineageTag: 4b9b55c7-c339-56e0-a3ca-d7933f21306a
    measure 'Opportunity Count' =
            [High Opportunity Pairs] + [Medium Opportunity Pairs]
        formatString: #,0
        displayFolder: '04 Opportunity'
        lineageTag: e080e362-de79-580c-93fc-e5d40f5880a6
    measure 'Avg Opportunity Score' =
            CALCULATE ( AVERAGE ( FactCityCategoryCoverage[opportunity_score] ), FactCityCategoryCoverage[is_candidate] = 1 )
        formatString: 0.00
        displayFolder: '04 Opportunity'
        lineageTag: b61f5190-b039-5ec4-81a5-2c2862288573
    measure 'Highest Opportunity Score' =
            CALCULATE ( MAX ( FactCityCategoryCoverage[opportunity_score] ), FactCityCategoryCoverage[is_candidate] = 1 )
        formatString: 0.00
        displayFolder: '04 Opportunity'
        lineageTag: c9b1285d-7cb9-570a-87e0-c62f936b0874
    measure 'Opportunity Score (Pair)' =
            IF ( MAX ( FactCityCategoryCoverage[is_candidate] ) = 1, MAX ( FactCityCategoryCoverage[opportunity_score] ) )
        formatString: 0.00
        displayFolder: '04 Opportunity'
        lineageTag: b0193ec7-728c-5c46-93ba-bd8f851a2c58
    measure 'Relative Representation (Pair)' =
            IF ( COUNTROWS ( FactCityCategoryCoverage ) = 1, MAX ( FactCityCategoryCoverage[relative_representation] ) )
        formatString: 0.0000
        displayFolder: '04 Opportunity'
        lineageTag: e44d8d76-52db-5ae9-887c-043a89e1b92f
    measure 'Avg Underrepresentation Points' =
            CALCULATE ( AVERAGE ( FactCityCategoryCoverage[underrepresentation_points] ), FactCityCategoryCoverage[is_candidate] = 1 )
        formatString: 0.00
        displayFolder: '04 Opportunity'
        lineageTag: 9f3df523-1659-5955-8b65-57eba5d4689b
    measure 'Avg Breadth Points' =
            CALCULATE ( AVERAGE ( FactCityCategoryCoverage[breadth_points] ), FactCityCategoryCoverage[is_candidate] = 1 )
        formatString: 0.00
        displayFolder: '04 Opportunity'
        lineageTag: 4fbebee6-f8b4-53f7-a0e8-6aeeb0e4a771
    measure 'Avg Reliability Points' =
            CALCULATE ( AVERAGE ( FactCityCategoryCoverage[reliability_points] ), FactCityCategoryCoverage[is_candidate] = 1 )
        formatString: 0.00
        displayFolder: '04 Opportunity'
        lineageTag: e0785fb7-b753-5971-bf7f-55c1fe0aa3b0

    partition _Measures = m
        mode: import
        source =
            #table(type table [MeasureHost = Int64.Type], {{0}})
