{
  "name": "BusinessPulse Corporate",
  "dataColors": [
    "#1F3A5F",
    "#2A9D8F",
    "#E9A23B",
    "#D1495B",
    "#6B7280",
    "#8FB8DE",
    "#A7C4A0",
    "#C9B037"
  ],
  "background": "#FFFFFF",
  "foreground": "#1F2933",
  "tableAccent": "#1F3A5F",
  "good": "#2A9D8F",
  "neutral": "#E9A23B",
  "bad": "#D1495B",
  "maximum": "#1F3A5F",
  "center": "#E9A23B",
  "minimum": "#EEF2F6",
  "textClasses": {
    "callout": {
      "fontSize": 20,
      "fontFace": "Segoe UI Semibold",
      "color": "#1F3A5F"
    },
    "title": {
      "fontSize": 10.5,
      "fontFace": "Segoe UI Semibold",
      "color": "#1F2933"
    },
    "header": {
      "fontSize": 9.5,
      "fontFace": "Segoe UI Semibold",
      "color": "#1F2933"
    },
    "label": {
      "fontSize": 9,
      "fontFace": "Segoe UI",
      "color": "#52606D"
    }
  },
  "visualStyles": {
    "card": {
      "*": {
        "labels": [
          {
            "fontSize": 20,
            "fontFamily": "Segoe UI Semibold",
            "color": {
              "solid": {
                "color": "#1F3A5F"
              }
            }
          }
        ],
        "categoryLabels": [
          {
            "show": false
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "rowPadding": 2,
            "textSize": 9
          }
        ],
        "columnHeaders": [
          {
            "fontSize": 9.5,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "values": [
          {
            "fontSize": 9,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "rowPadding": 2,
            "textSize": 9
          }
        ],
        "columnHeaders": [
          {
            "fontSize": 9.5,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "values": [
          {
            "fontSize": 9,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    }
  }
}