            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "FactListings"
                    }
                  },
                  "Property": "Average Quality Score"
                }
              },
              "queryRef": "FactListings.Average Quality Score"
            }
          ]
