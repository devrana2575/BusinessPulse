            )
        formatString: #,##0
        lineageTag: fa11f2a1-6163-5565-ac82-f1010b85b228
    measure 'Completeness %' =
            DIVIDE ( [Complete Listings], [Total Listings], 0 )
        formatString: 0.0%
        lineageTag: 10ca29c3-12ea-5250-9380-86cb9e2ee349
    measure 'Complete Records Percentage' =
            [Completeness %]
        formatString: 0.0%
        lineageTag: 936309de-ee4f-5f00-977b-481e38429691
    measure 'Average Quality Score' =
            AVERAGE ( FactDataQuality[quality_score] )
        formatString: 0.0
        lineageTag: 507935d0-2597-5caf-b286-53936430132f
    measure 'Needs Review Count' =
            CALCULATE (
                COUNTROWS ( FactDataQuality ),
                FactDataQuality[validation_status] = "needs_review"
            )
        formatString: #,##0
        lineageTag: 697e2ab8-6ab6-5265-b501-0259cc2a654a
    measure 'Needs Review %' =
            DIVIDE ( [Needs Review Count], [Total Listings], 0 )
        formatString: 0.0%
        lineageTag: a87b9b91-3b2a-5296-a208-14cb264b500b
    measure 'Valid Listings' =
            CALCULATE (
                COUNTROWS ( FactDataQuality ),
                FactDataQuality[validation_status] = "valid"
            )
        formatString: #,##0
        lineageTag: d3e99441-2d04-54a5-b54f-85d360ba6e12
    measure 'Source Completeness %' =
            DIVIDE ( [Complete Listings], [Total Listings], 0 )


            // -----------------------------------------------------------------------------
            // 05. City-category coverage
            // -----------------------------------------------------------------------------
        formatString: 0.0%
        lineageTag: ba0331a3-56fd-52ca-a2a4-8d8060e27185
    measure 'City-Category Combinations' =
            COUNTROWS ( FactCityCategoryCoverage )
        lineageTag: b78dc124-4e25-5a18-b9fd-c3864aeaeca1
    measure 'Covered City-Category Combinations' =
            SUM ( FactCityCategoryCoverage[is_covered] )
        lineageTag: 58e0edcf-0bd7-5ba3-9831-1ab9eab1c379
    measure 'Category Coverage %' =
            DIVIDE (
                [Covered City-Category Combinations],
                [City-Category Combinations],
                0
            )
        formatString: 0.0%
        lineageTag: e867dbd0-adeb-589f-8ad1-3c12dbb9bafe
    measure 'Uncovered Share %' =
            1 - [Category Coverage %]
        formatString: 0.0%
        lineageTag: cabc7735-c43a-5325-838e-ce1a0e0aa869
    measure 'Average Listings per City-Category' =
            DIVIDE (
                SUM ( FactCityCategoryCoverage[listing_count] ),
                [City-Category Combinations],
                0
            )
        lineageTag: 65904d33-0815-5c3e-b40c-b5ec16627e96
    measure 'Candidate City-Category Pairs' =
            COUNTROWS (
                FILTER (
                    FactCityCategoryCoverage,
                    FactCityCategoryCoverage[is_candidate] = 1
                )
            )
        formatString: #,##0
        lineageTag: d43a45af-7868-5502-a306-8fce7e1178e5
    measure 'Candidate Opportunity Score' =
            CALCULATE (
                AVERAGE ( FactCityCategoryCoverage[opportunity_score] ),
                FactCityCategoryCoverage[is_candidate] = 1
            )
        formatString: 0.0
        lineageTag: 4e2aefe1-d5d4-56e2-a465-d19eeb07480e
    measure 'Candidate Underrepresentation Points' =
            CALCULATE (
                AVERAGE ( FactCityCategoryCoverage[underrepresentation_points] ),
                FactCityCategoryCoverage[is_candidate] = 1
            )
        formatString: 0.0
        lineageTag: 36ebba67-6eba-5613-885c-bbc1c83a78a7
    measure 'Candidate Breadth Points' =
            CALCULATE (
                AVERAGE ( FactCityCategoryCoverage[breadth_points] ),
                FactCityCategoryCoverage[is_candidate] = 1
            )
        formatString: 0.0
        lineageTag: df8dd7d5-3080-5f86-bca7-fad801a66ecd
    measure 'Candidate Reliability Points' =
            CALCULATE (
                AVERAGE ( FactCityCategoryCoverage[reliability_points] ),
                FactCityCategoryCoverage[is_candidate] = 1
            )


            // -----------------------------------------------------------------------------
            // 06. Opportunity scoring (descriptive, not a demand forecast)
            // -----------------------------------------------------------------------------

            // Average is appropriate for a card or a city/category visual row. Do not sum
            // this measure across rows.
        formatString: 0.0
        lineageTag: ae3c8657-c089-538a-92b7-f091251c292e
    measure 'Opportunity Score' =
            AVERAGE ( FactCityCategoryCoverage[opportunity_score] )
        formatString: 0.0
        lineageTag: 4c58df8b-08bb-5d02-8c0a-a075773da5cb
    measure 'Top Opportunity Score' =
            CALCULATE (
                MAX ( FactCityCategoryCoverage[opportunity_score] ),
                FactCityCategoryCoverage[is_candidate] = 1
            )
        formatString: 0.0
        lineageTag: 93893cbb-cd99-50af-9871-2fbdb6e83698
    measure 'High Opportunity Gaps' =
            COUNTROWS (
                FILTER (
                    FactCityCategoryCoverage,
                    FactCityCategoryCoverage[is_candidate] = 1
                        && FactCityCategoryCoverage[opportunity_tier] = "High"
                )
            )
        formatString: #,##0
        lineageTag: afac96f7-1514-5619-b24f-32954d4ef2e7
    measure 'Medium Opportunity Gaps' =
            COUNTROWS (
                FILTER (
                    FactCityCategoryCoverage,
                    FactCityCategoryCoverage[is_candidate] = 1
                        && FactCityCategoryCoverage[opportunity_tier] = "Medium"
                )
            )
        formatString: #,##0
        lineageTag: cb33cbd0-f3c0-5c53-a841-f4651861428b
    measure 'Underrepresented Categories' =
            COUNTROWS (
                FILTER (
                    FactCityCategoryCoverage,
                    FactCityCategoryCoverage[is_candidate] = 1
                        && FactCityCategoryCoverage[relative_representation] < 0.5
                )
            )
        formatString: #,##0
        lineageTag: 300c1363-bf14-5026-843c-3de6c04b3b4a
    measure 'Underrepresentation Points' =
            AVERAGE ( FactCityCategoryCoverage[underrepresentation_points] )
        formatString: 0.0
        lineageTag: f28e2eac-13d5-50da-a5c1-e439ece5cec7
    measure 'Breadth Points' =
            AVERAGE ( FactCityCategoryCoverage[breadth_points] )
        formatString: 0.0
        lineageTag: 314c8127-5ab5-551a-bafa-57ef1b8cd6dc
    measure 'Reliability Points' =
            AVERAGE ( FactCityCategoryCoverage[reliability_points] )
        formatString: 0.0
        lineageTag: d031195b-8eaf-5e30-8c82-4ff9fed64be9
    measure 'Methodology Note' =
            SELECTEDVALUE ( FactCityCategoryCoverage[methodology_note], "Opportunity methodology not available" )
        lineageTag: a1e63d95-258f-595a-934e-86d0fb365e32
    measure 'Report Context' =
            "Snapshot "
                & FORMAT ( [Snapshot Date], "yyyy-mm-dd" )
                & " | OpenStreetMap contributors (ODbL 1.0) | Collected POIs, not a census"
        lineageTag: 1b4a82e9-5819-5219-9598-8c248bc27b0c
    measure 'Opportunity Caveat' =
            "Ranks underrepresentation in collected listings only; not demand, revenue, or competition."
        lineageTag: e7943858-526e-5ebc-a9f3-dc8556383586

    partition FactListings = m
        mode: import
        source =
            let
                Source = RawListings,
                AddListingId = Table.AddColumn(Source, "listing_id", each [business_id], type text),
                CityKeys = Table.Distinct(Table.SelectColumns(RawOpportunities, {"city_id", "city_name"})),
                CategoryKeys = Table.Distinct(Table.SelectColumns(RawOpportunities, {"category_id", "category_name"})),
                JoinCity = Table.NestedJoin(AddListingId, {"city"}, CityKeys, {"city_name"}, "City", JoinKind.LeftOuter),
                ExpandCity = Table.ExpandTableColumn(JoinCity, "City", {"city_id"}, {"city_id"}),
                JoinCategory = Table.NestedJoin(ExpandCity, {"category"}, CategoryKeys, {"category_name"}, "Category", JoinKind.LeftOuter),
                ExpandCategory = Table.ExpandTableColumn(JoinCategory, "Category", {"category_id"}, {"category_id"}),
                AddSourceId = Table.AddColumn(ExpandCategory, "source_id", each 1, Int64.Type),
                TypedColumns = Table.TransformColumnTypes(AddSourceId, {
                    {"listing_id", type text},
                    {"business_id", type text},
                    {"business_name", type text},
                    {"city_id", Int64.Type},
                    {"category_id", Int64.Type},
                    {"source_id", Int64.Type},
                    {"address", type text},
                    {"phone", type text},
                    {"source_record_id", type text},
                    {"collection_date", type date},
                    {"latitude", type number},
                    {"longitude", type number}
                }, "en-US"),
                SelectedColumns = Table.SelectColumns(TypedColumns, {
                    "listing_id", "business_id", "business_name", "city_id", "category_id",
                    "source_id", "address", "phone", "source_record_id", "collection_date",
                    "latitude", "longitude"
                })
            in
                SelectedColumns
