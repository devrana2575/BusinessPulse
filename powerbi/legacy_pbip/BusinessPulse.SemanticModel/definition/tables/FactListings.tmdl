        formatString: 0.0%
        lineageTag: d47878d4-b383-53d1-806d-c49911e152e7
    measure 'Potential Duplicate Listings' =
            COUNTROWS (
                FILTER ( FactDataQuality, FactDataQuality[potential_duplicate_flag] = 1 )
            )
        formatString: #,##0
        lineageTag: d440ca63-da21-58a0-b6c1-6cb3aab6bd25
    measure 'Complete Listings' =
            COUNTROWS (
