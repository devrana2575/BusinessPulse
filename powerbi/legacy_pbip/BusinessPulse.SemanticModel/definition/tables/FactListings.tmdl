    measure 'Listings by Source' =
            COUNTROWS ( FactListings )
        formatString: #,##0
        lineageTag: dac98d14-0747-5838-8e73-9e89a30310f5
    measure 'Snapshot Date' =
            MIN ( FactListings[collection_date] )
        formatString: yyyy-mm-dd
        lineageTag: df1fdfee-779c-57c7-bbf1-833b9b67ea75
    measure 'Collection Snapshot Label' =
            "Snapshot: " & FORMAT ( [Snapshot Date], "yyyy-mm-dd" )


            // -----------------------------------------------------------------------------
            // 02. Geographic contribution and ranking
            // -----------------------------------------------------------------------------

            // Requested definition: share of the entire model, ignoring city filters.
        lineageTag: 1897d3fb-3357-5635-9a80-27fcb7b828c9
    measure 'City Contribution %' =
            DIVIDE (
                [Listings by City],
                CALCULATE ( [Total Listings], ALL ( DimCity ) ),
                0
            )

            // Slicer-aware alternative used on the geographic page.
        formatString: 0.0%
        lineageTag: 12faeafa-8d6e-5395-a084-94205afcd0ff
    measure 'City Contribution % (Selected)' =
            DIVIDE (
                [Listings by City],
                CALCULATE ( [Total Listings], ALLSELECTED ( DimCity ) ),
                0
            )
        lineageTag: a59a2da2-2c72-51b9-9e3e-5a92a5571b47
    measure 'City Rank' =
            RANKX (
                ALLSELECTED ( DimCity[city_name] ),
                [Total Listings],
                ,
                DESC,
                DENSE
            )
        formatString: #,##0
        lineageTag: b1b2a2d2-8614-5dc6-b939-9e40459d70f3
    measure 'City Rank (All Cities)' =
            RANKX (
                ALL ( DimCity[city_name] ),
                [Total Listings],
                ,
                DESC,
                DENSE
            )


            // -----------------------------------------------------------------------------
            // 03. Category contribution, rank and within-city share
            // -----------------------------------------------------------------------------
        formatString: #,##0
        lineageTag: 96c74acb-8d99-5900-b60b-bf156f3c1f01
    measure 'Category Contribution %' =
            DIVIDE (
                [Listings by Category],
                CALCULATE ( [Total Listings], ALL ( DimCategory ) ),
                0
            )
        formatString: 0.0%
        lineageTag: 4e68678c-6986-5a85-b42e-4807b28f5a7e
    measure 'Category Rank' =
            RANKX (
                ALLSELECTED ( DimCategory[category_name] ),
                [Total Listings],
                ,
                DESC,
                DENSE
            )

            // In a city context this is the category share of that city. With no city
            // filter it is the category share of the whole collected sample.
        formatString: #,##0
        lineageTag: 6c372810-43e6-59a8-97b4-c2c00a8e18c3
    measure 'Category Share in City %' =
            DIVIDE (
                [Listings by Category],
                CALCULATE ( [Total Listings], ALLSELECTED ( DimCategory ) ),
                0
            )
        formatString: 0.0%
        lineageTag: 18bdabdc-0046-5bf0-bda6-ea5901461b20
    measure 'Listings per City' =
            DIVIDE ( [Total Listings], [Distinct Cities], 0 )
        lineageTag: 07ae8355-5887-5878-8b44-95407208290e
    measure 'Average Listings per City' =
            [Listings per City]
        formatString: #,##0.0
        lineageTag: b6600359-855f-55fa-b3e2-6a0d32a3c9c6
    measure 'Highest City Listing Count' =
            MAXX (
                ALLSELECTED ( DimCity[city_id] ),
                CALCULATE ( [Total Listings] )
            )
        formatString: #,##0
        lineageTag: e2aaf2e7-cbec-556d-9534-2c764f2a6912
    measure 'Lowest City Listing Count' =
            MINX (
                FILTER (
                    ALLSELECTED ( DimCity[city_id] ),
                    CALCULATE ( [Total Listings] ) > 0
                ),
                CALCULATE ( [Total Listings] )
            )
        formatString: #,##0
        lineageTag: e3719272-d7d2-583b-a7e8-ebc1bea2ba75
    measure 'Source Share %' =
            DIVIDE (
                [Listings by Source],
                CALCULATE ( [Total Listings], ALL ( DimSource ) ),
                0
            )

            // Share of represented source cities covered by the current category/source
            // selection. City filters are cleared so a city slicer does not change the
            // denominator.
        formatString: 0.0%
        lineageTag: c218e9e6-8ac5-5bb6-a261-446c504ac10b
    measure 'City Coverage %' =
            DIVIDE (
                CALCULATE ( [Distinct Cities], REMOVEFILTERS ( DimCity ) ),
                CALCULATE ( DISTINCTCOUNT ( DimCity[city_id] ), REMOVEFILTERS ( DimCity ) ),
                0
            )
        formatString: 0.0%
        lineageTag: bf997bfb-e28e-5cfd-bf8b-122791738b3b
    measure 'Listings with Coordinates' =
            COUNTROWS (
                FILTER (
                    FactListings,
                    NOT ISBLANK ( FactListings[latitude] )
                        && NOT ISBLANK ( FactListings[longitude] )
                )
            )

            // Coordinate completeness in the collected dataset, not geographic land-area
            // coverage.
        lineageTag: bffa077d-4d93-5cf2-bc03-91376a90a893
    measure 'Geographic Coverage %' =
            DIVIDE ( [Listings with Coordinates], [Total Listings], 0 )
        formatString: 0.0%
        lineageTag: 463265ae-1775-5fe8-9ca9-8999129f1553
    measure 'Top City Contribution %' =
            MAXX (
                ALLSELECTED ( DimCity[city_id] ),
                [City Contribution % (Selected)]
            )

            // HHI is calculated over collected-listing shares, not commercial market
            // shares. It ranges from 1 / represented cities to 1.
        formatString: 0.0%
        lineageTag: f218c842-4862-5a40-bc35-5b5d16a3bab9
    measure 'City Concentration HHI (Collected Listings)' =
            SUMX (
                ALLSELECTED ( DimCity[city_id] ),
                POWER ( [City Contribution % (Selected)], 2 )
            )


            // -----------------------------------------------------------------------------
            // 04. Data quality
            // -----------------------------------------------------------------------------

            // FactDataQuality is filtered through the 1:1 relationship from FactListings:
            // DimCity/DimCategory/DimSource -> FactListings -> FactDataQuality.
        formatString: 0.0000
        lineageTag: 53111cef-42c8-5bc1-9a1d-daf4ef7883ce
    measure 'Missing Phone Count' =
            COUNTROWS (
                FILTER ( FactDataQuality, FactDataQuality[missing_phone] = 1 )
            )
        formatString: #,##0
        lineageTag: ee7038aa-a25e-5ae0-9761-780eb12530f8
    measure 'Missing Phone %' =
            DIVIDE ( [Missing Phone Count], [Total Listings], 0 )

            // Availability means the source published a nonblank value. It does not imply
            // that the phone is valid or that a business can be contacted.
        formatString: 0.0%
        lineageTag: ddca5430-7552-5f1a-a922-320e12648b5f
    measure 'Listings with Phone Numbers' =
