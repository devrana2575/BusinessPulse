        lineageTag: fa543a3b-a65c-5304-85af-76d1112b4f6e
    measure 'Listings without Phone Numbers' =
            [Missing Phone Count]
        lineageTag: 316e39fc-42b4-56a1-b17a-c9057aeda42c
    measure 'Phone Availability Percentage' =
