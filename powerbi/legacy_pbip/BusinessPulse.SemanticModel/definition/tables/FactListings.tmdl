        formatString: 0.0%
        lineageTag: 6775a4c0-d9ab-5c78-8d0c-e1ce88d4a92a
    measure 'Listings with Addresses' =
            COUNTROWS (
                FILTER ( FactDataQuality, FactDataQuality[missing_address] = 0 )
            )

            // address_valid follows the documented minimum usability rule; it is not
            // proof of a real-world address.
        lineageTag: 7994ded3-944b-56bf-a72d-a551b5a153d9
    measure 'Listings with Complete Addresses' =
            COUNTROWS (
